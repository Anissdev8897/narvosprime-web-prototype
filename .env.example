# ═══════════════════════════════════════════════════════════
# NARVOS PRIME — Configuration centralisée (UNIQUE source de vérité)
# Copier en `.env` et adapter. Lu par l'orchestrateur Node et par Vite (envDir).
# ═══════════════════════════════════════════════════════════
MODE=dev                       # dev | production

# ── Base de données ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=worldnevaros

# ── Ports services ──
NODE_WS_PORT=8080
GATEWAY_PORT=8082
CPP_CORE_PORT=8081

# ── Client (exposé au navigateur par Vite) ──
VITE_GAME_WS_URL=ws://127.0.0.1:8082/ws
# VITE_USE_WSS=true      # Décommenter pour utiliser wss:// au lieu de ws://
# VITE_WSS_CERT=./certs/dev-cert.pem
# VITE_WSS_KEY=./certs/dev-key.pem

# ── Sécurité ──
JWT_SECRET=CHANGE_ME_generate_random_64byte_secret
TOKEN_EXPIRY_HOURS=1
BCRYPT_ROUNDS=10

# ── Modules activables ──
ENABLE_CPP_CORE=true
ENABLE_GATEWAY=true
ENABLE_CLIENT=true
ENABLE_PYTHON_AI=false
ENABLE_RUST_BUILD=false

# ── Orchestrateur ──
KILL_BUSY_PORTS=ask            # ask | always | never
RESTART_MAX_RETRIES=5
RESTART_WINDOW_MS=60000
WATCHDOG_INTERVAL_MS=5000
WATCHDOG_MEM_MB=1024
WATCHDOG_CPU_PCT=90
WS_LATENCY_INTERVAL_MS=10000
WS_LATENCY_WARN_MS=200
HEALTHCHECK_INTERVAL_MS=5000

# ── Logs ──
LOG_LEVEL=info
LOG_DIR=./logs