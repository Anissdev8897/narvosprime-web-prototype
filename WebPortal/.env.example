# Token Hugging Face (génération d'images gratuite, quota)
# VITE_HF_TOKEN=«redacted:hf_…»

# Serveur SD local (génération d'assets avec stable-diffusion-3.5-large)
# Décommenter si le serveur Python sd_inference_server.py tourne (ex: .\scripts\start_sd_server.ps1)
# VITE_LOCAL_SD_URL=http://localhost:5002

# ══════════════════════════════════════════════════════════════════════
# RÉSEAU P0 — WebSocket TLS (WSS)
# ══════════════════════════════════════════════════════════════════════

# Activer wss:// au lieu de ws://
# Valeurs: true | 1 | false | 0 (défaut: false)
# VITE_USE_WSS=true

# URL complète du WebSocket Game Server (prioritaire sur VITE_USE_WSS)
# Exemple: wss://game.narvosprime.com:8082/ws
# VITE_GAME_WS_URL=wss://localhost:8082/ws

# Chemins des certificats TLS (pour le serveur WebSocket uniquement)
# VITE_WSS_CERT=./certs/dev-cert.pem
# VITE_WSS_KEY=./certs/dev-key.pem

# Générer les certificats de développement :
#   node scripts/generate-dev-certs.js